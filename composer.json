{
    "name": "morphp/medas-config-manager",
    "description": "Medas config manager",
    "authors": [
        {
            "name": "Patrick Morpey",
            "email": "patrick@morphp.nl"
        }
    ],
    "type": "library",
    "require": {
        "morphp/medas-core": "@dev",
        "morphp/medas-service-manager": "@dev",
        "symfony/yaml": "~5.3",
        "vlucas/phpdotenv": "^5.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../core"
        },
        {
            "type": "path",
            "url": "../service-manager"
        }
    ],
    "autoload": {
        "psr-4": {
            "Medas\\ConfigManager\\": "src/",
            "Medas\\Test\\": "tests/"
        }
    }
}
